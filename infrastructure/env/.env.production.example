# ==============================================================================
# AgriDrone Production Environment Template (.env.production.example)
# DO NOT PUT REAL SECRETS IN THIS TEMPLATE OR COMMIT PRODUCTION SECRETS TO GIT!
# Real production file MUST be stored at /opt/agridrone/secrets/.env.production (chmod 0600)
# ==============================================================================

# Core Domains & Network
ENV_FILE=infrastructure/env/.env.production.example
APP_DOMAIN=api.agridrone.vn
ACME_EMAIL=admin@agridrone.vn
ASPNETCORE_ENVIRONMENT=Production

# Database (PostgreSQL 17 + PostGIS 3.5)
POSTGRES_DB=agridrone
POSTGRES_USER=agridrone_app
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD_32_CHARS
ConnectionStrings__AgriDrone=Host=postgres;Port=5432;Database=agridrone;Username=agridrone_app;Password=CHANGE_ME_RANDOM_PASSWORD_32_CHARS;Include Error Detail=false

# Migration & Validation (Separated from runtime startup)
DatabaseInitialization__ApplyMigrationsOnStartup=false
DatabaseInitialization__ValidateCoreMasterDataOnStartup=true

# Authentication (JWT)
Jwt__Issuer=https://api.agridrone.vn
Jwt__Audience=agridrone-clients
Jwt__Secret=CHANGE_ME_MINIMUM_32_CHARACTERS_SECURE_KEY_JWT_2026
Jwt__AccessTokenExpirationMinutes=15
Jwt__TenantSelectionTokenExpirationMinutes=5

# Message Broker (RabbitMQ 4.2.7)
RabbitMq__Enabled=true
RabbitMq__HostName=rabbitmq
RabbitMq__Port=5672
RabbitMq__UserName=agridrone
RabbitMq__Password=CHANGE_ME_RANDOM_RABBIT_PASSWORD
RabbitMq__VirtualHost=agridrone

# Cache (Redis 8.8.1)
Redis__Enabled=true
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD
Redis__ConnectionString=redis:6379,password=CHANGE_ME_RANDOM_REDIS_PASSWORD,abortConnect=false

# Object Storage (MinIO Internal vs Public Presigned URL)
ObjectStorage__Enabled=true
ObjectStorage__Endpoint=http://minio:9000
ObjectStorage__PublicEndpoint=https://media.agridrone.vn
ObjectStorage__Bucket=agridrone-media
ObjectStorage__Region=us-east-1
ObjectStorage__AccessKey=CHANGE_ME_MINIO_ACCESS_KEY
ObjectStorage__SecretKey=CHANGE_ME_MINIO_SECRET_KEY
ObjectStorage__UseSsl=false
ObjectStorage__PresignedUrlExpiryMinutes=15

# Email (Amazon SES SMTP Singapore)
Email__Smtp__Enabled=true
Email__Smtp__Host=email-smtp.ap-southeast-1.amazonaws.com
Email__Smtp__Port=587
Email__Smtp__SecurityMode=StartTls
Email__Smtp__Username=CHANGE_ME_SES_SMTP_USER
Email__Smtp__Password=CHANGE_ME_SES_SMTP_PASSWORD
Email__Smtp__FromAddress=no-reply@agridrone.vn
Email__Smtp__FromName=AgriDrone Demo
Email__Smtp__TimeoutSeconds=30

# Safety Flags & SePay Integration (Must remain fail-closed until Phase V3-10)
SurveyPayments__Enabled=false
SurveyPayments__Provider=sepay
LegacyFeatures__EnableDeprecatedEndpoints=false

SePay__Environment=Sandbox
SePay__MerchantId=CHANGE_ME_SEPAY_MERCHANT_ID
SePay__SecretKey=CHANGE_ME_SEPAY_SECRET_KEY
SePay__IpnSecretKey=CHANGE_ME_INDEPENDENT_RANDOM_IPN_KEY
SePay__SuccessUrl=https://app.agridrone.vn/payment/success
SePay__ErrorUrl=https://app.agridrone.vn/payment/error
SePay__CancelUrl=https://app.agridrone.vn/payment/cancel
SePay__PaymentCodePrefix=AGD

# Initial System Admin Bootstrap (Turn false after first login verification)
Identity__SystemAdminBootstrap__Enabled=true
Identity__SystemAdminBootstrap__Email=admin@agridrone.vn
Identity__SystemAdminBootstrap__FullName=System Administrator

# CORS Configuration (Set your verified Frontend URL)
Cors__AllowedOrigins__0=https://app.agridrone.vn
