@startuml
skinparam style strictuml
hide footbox
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ArrowColor black
skinparam ArrowThickness 1
skinparam sequence {
    LifeLineBorderColor black
    LifeLineBackgroundColor white
    ParticipantBackgroundColor white
    ParticipantBorderColor black
    ActorBackgroundColor white
    ActorBorderColor black
    GroupBorderColor black
    GroupBackgroundColor white
}

title SD-01 (Sub-system level) — AI Disease Detection, Plant Health Map & Flagged Locations Review

actor "<u.:SystemManager./u>" as SM
participant "«container»\n<u.:ManagerUI./u>\n[Interface]" as UI
participant "«container»\n<u.:PlantHealthService./u>\n[Service]" as API
participant "«container»\n<u.:ObjectStorage./u>\n[container]" as ST
participant "«container»\n<u.:Database./u>\nDatabase" as DB

== Trigger AI Disease Detection & GPS Flagging (UC-25) ==

SM -> UI ++ : trigger disease detection
UI -> API ++ : send disease detection request
API -> DB ++ : Fetch active farm plants
DB --> API -- : return active plants

note over API
  <b>Haversine Distance Matching (Tolerance = 2.5m):</b>
  • minDistance <= 2.5m: match to nearest tree (reviewStatus = <b>'Matched'</b>)
  • minDistance > 2.5m: outlier/drift (reviewStatus = <b>'Pending' [FLAGGED]</b>)
end note

API -> DB ++ : Persist disease observations & pending flags
DB --> API -- : OK
API --> UI -- : 200 OK
UI --> SM -- : Show AI detection results ({Y} flagged for review)

== View Plant Health Analysis (UC-26) ==

SM -> UI ++ : Open plant health map
UI -> API ++ : get plant health map
API -> DB ++ : Fetch plant health map data & observations
DB --> API -- : return map data, plant pins & flags
API -> ST ++ : request map preview URL
ST --> API -- : return presignedUrl
API --> UI -- : 200 OK (baseMap, summary, plants, flags)
UI -> ST ++ : download map preview
ST --> UI -- : 200 OK
UI --> SM -- : Render interactive map with colored pins & flagged badges

== Review Suspected Disease Detections (UC-27) ==

SM -> UI ++ : Select diseased plant pin
UI -> ST ++ : download crop image
ST --> UI -- : 200 OK (crop & annotated bytes)
UI --> SM -- : Display high-res crop modal

alt decision = Confirmed: valid disease symptom
    SM -> UI : Submit review decision = "Confirmed"
    UI -> API ++ : send confirm disease review
    API -> DB ++ : Update observation = 'Confirmed' & plant health status
    DB --> API -- : OK
    API --> UI -- : 200 OK
else decision = Rejected (False Positive / Sunburn / Scarring)
    SM -> UI : Submit review decision = "Rejected"
    UI -> API : send reject disease review
    API -> DB ++ : Update observation = 'Rejected' & restore healthy status
    DB --> API -- : OK
    API --> UI -- : 200 OK
end
UI --> SM -- : Update plant marker color & badge on map

== Review Flagged Plant Locations (UC-28) ==

SM -> UI ++ : Open flagged locations tab
UI -> API ++ : get flagged locations
API -> DB ++ : Fetch flagged pending observations
DB --> API -- : return flagged candidates
API --> UI -- : 200 OK
UI --> SM -- : Display flagged outlier list & candidate target poles

alt option = Snap / Match with existing pole
    SM -> UI : Resolve snap to existing pole
    UI -> API ++ : send snap pole request
    API -> DB ++ : Snap observation to target pole
    DB --> API -- : OK
    API --> UI -- : 200 OK
else option = Mark as new unmapped plant pole
    SM -> UI : Resolve mark as new plant
    UI -> API ++ : send register new plant request
    API -> DB ++ : Register new unmapped plant pole
    DB --> API -- : OK
    API --> UI -- : 201 Created
else option = Dismiss (False positive / Noise)
    SM -> UI : Resolve dismiss outlier
    UI -> API ++ : send dismiss outlier request
    API -> DB ++ : Dismiss flagged observation
    DB --> API -- : OK
    API --> UI -- : 200 OK
end
UI --> SM -- : Remove flagged pin from map & update stats

@enduml
