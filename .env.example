# Copy this file to `.env` for local development or use the same variable names
# in the target deployment secret/configuration store. Never commit `.env`.

POSTGRES_DB=agridrone
POSTGRES_USER=agridrone
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5433

# The bootstrap account above only creates the two isolated service databases.
# Runtime services use these distinct owners and cannot connect to each other's DB.
BE1_DB_NAME=agridrone_be1
BE1_DB_USERNAME=agridrone_be1
BE1_DB_PASSWORD=replace-with-separate-be1-password
BE2_DB_NAME=agridrone_be2
BE2_DB_USERNAME=agridrone_be2
BE2_DB_PASSWORD=replace-with-separate-be2-password

RABBITMQ_USER=agridrone
RABBITMQ_PASSWORD=replace-with-local-password
RABBITMQ_VHOST=agridrone
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PASSWORD=replace-with-local-password
REDIS_PORT=6379
BE1_CACHE_PREFIX=agridrone:be1
BE2_CACHE_PREFIX=agridrone:be2
BE1_CACHE_ENABLED=true
BE1_CACHE_DEFAULT_TTL=5m
BE1_CACHE_TIMEOUT=2s

# Keep consumers/dispatcher disabled until a capability explicitly owns a queue.
BE1_MESSAGING_ENABLED=false
BE1_OUTBOX_MAX_ATTEMPTS=8
BE1_OUTBOX_CONFIRM_TIMEOUT=5s

# Initial administrator creation is off by default. Email and full name are
# validated at startup when it is enabled.
BE1_SYSTEM_ADMIN_BOOTSTRAP_ENABLED=false
BE1_SYSTEM_ADMIN_EMAIL=
BE1_SYSTEM_ADMIN_FULL_NAME=System Administrator

# Phase 1 keeps BE1 Java on a separate port; no traffic is switched yet.
BE1_HTTP_PORT=8081
BE2_HTTP_PORT=8080
BE2_JWT_SECRET=replace-with-at-least-32-random-characters

# Public frontend links embedded in invitation and password-reset emails.
TENANT_INVITATION_ACCEPT_URL=http://localhost:5173/accept-invitation
SYSTEM_MANAGER_INVITATION_ACCEPT_URL=http://localhost:5173/accept-system-manager-invitation
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# SMTP delivery belongs to BE2 while the migration is in progress. Keep it off
# unless all connection values are supplied by the deployment environment.
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY_MODE=StartTls
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=AgriDrone
SMTP_TIMEOUT_SECONDS=30
