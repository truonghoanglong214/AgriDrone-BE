{
  "Gateway": {
    "DocsEnabled": true,
    "IdentityUpstream": "be2",
    "AllowedOrigins": [
      "http://localhost:5173"
    ],
    "ReadinessEndpoints": [
      "http://be1-java:8080/actuator/health/readiness",
      "http://be2-dotnet:8080/health/ready"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient.readiness": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-login": {
        "ClusterId": "be2",
        "Order": -100,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "identity-forgot-password": {
        "ClusterId": "be2",
        "Order": -100,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/forgot-password",
          "Methods": [ "POST" ]
        }
      },
      "identity-reset-password": {
        "ClusterId": "be2",
        "Order": -100,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/reset-password",
          "Methods": [ "POST" ]
        }
      },
      "be1-jwks": {
        "ClusterId": "be1",
        "Order": -100,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "docs",
        "Match": {
          "Path": "/.well-known/jwks.json",
          "Methods": [ "GET" ]
        }
      },
      "be1-openapi": {
        "ClusterId": "be1",
        "Order": -100,
        "RateLimiterPolicy": "docs",
        "Match": {
          "Path": "/docs/be1/openapi.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/v3/api-docs" }
        ]
      },
      "be2-openapi": {
        "ClusterId": "be2",
        "Order": -100,
        "RateLimiterPolicy": "docs",
        "Match": {
          "Path": "/docs/be2/openapi.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathSet": "/swagger/v1/swagger.json" }
        ]
      },
      "be2-media-upload": {
        "ClusterId": "be2",
        "Order": -50,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "api",
        "MaxRequestBodySize": 5369757696,
        "Match": {
          "Path": "/api/missions/{missionId}/farms/{farmId}/media",
          "Methods": [ "POST" ]
        }
      },
      "be2-api-fallback": {
        "ClusterId": "be2",
        "Order": 1000,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "be2-invitation-accept": {
        "ClusterId": "be2",
        "Order": 1000,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/invitations/accept",
          "Methods": [ "POST" ]
        }
      },
      "be2-current-profile": {
        "ClusterId": "be2",
        "Order": 1000,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/current/profile",
          "Methods": [ "PUT" ]
        }
      },
      "be2-current-change-password": {
        "ClusterId": "be2",
        "Order": 1000,
        "CorsPolicy": "frontend",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/current/change-password",
          "Methods": [ "PUT" ]
        }
      }
    },
    "Clusters": {
      "be1": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/actuator/health/readiness"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "primary": {
            "Address": "http://be1-java:8080/"
          }
        }
      },
      "be2": {
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:03",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:30"
          }
        },
        "Destinations": {
          "primary": {
            "Address": "http://be2-dotnet:8080/"
          }
        }
      }
    }
  }
}
