{
  "ConnectionStrings": {
    "AgriDrone": ""
  },
  "DatabaseInitialization": {
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "AgriDrone.Api",
    "Audience": "AgriDrone.Clients",
    "AccessTokenExpirationMinutes": 15,
    "TenantSelectionTokenExpirationMinutes": 5
  },
  "Email": {
    "Smtp": {
      "Enabled": false,
      "Host": "",
      "Port": 587,
      "SecurityMode": "StartTls",
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "AgriDrone",
      "TimeoutSeconds": 30
    }
  },
  "Identity": {
    "TenantInvitations": {
      "AcceptUrl": "",
      "ExpirationHours": 24
    },
    "PasswordReset": {
      "ResetUrl": "http://localhost:5173/reset-password",
      "ExpirationMinutes": 30
    },
    "SystemAdminBootstrap": {
      "Enabled": false,
      "Email": "",
      "FullName": "System Administrator"
    }
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "agridrone",
    "UserName": "agridrone",
    "Password": "",
    "ConnectionName": "agridrone-api",
    "Exchange": "agridrone.integration",
    "RetryExchange": "agridrone.integration.retry",
    "DeadLetterExchange": "agridrone.integration.dlx",
    "PrefetchCount": 8,
    "InitialConnectionRetrySeconds": 5,
    "NetworkRecoverySeconds": 5,
    "RetryDelaysSeconds": [ 5, 30, 120 ],
    "Consumers": [
      {
        "Name": "be1-mapping-candidates-approved-v1",
        "QueueName": "agridrone.be1.mapping-candidates-approved.v1",
        "RoutingKey": "mapping.candidates-approved.v1"
      },
      {
        "Name": "be2-zone-map-published-v1",
        "QueueName": "agridrone.be2.zone-map-published.v1",
        "RoutingKey": "mapping.zone-map-published.v1"
      },
      {
        "Name": "email-tenant-invitation-v1",
        "QueueName": "agridrone.email.tenant-invitation.v1",
        "RoutingKey": "identity.tenant-invitation-email-requested.v1"
      },
      {
        "Name": "be1-health-observations-ready-v1",
        "QueueName": "agridrone.be1.health-observations-ready.v1",
        "RoutingKey": "health.observations-ready.v1"
      },
      {
        "Name": "be2-health-review-state-changed-v1",
        "QueueName": "agridrone.be2.health-review-state-changed.v1",
        "RoutingKey": "health.review-state-changed.v1"
      }
    ]
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "",
    "InstancePrefix": "agridrone",
    "PlantReferenceTtlSeconds": 300,
    "InvalidationEpochTtlSeconds": 2592000
  },
  "Messaging": {
    "Outbox": {
      "Enabled": true,
      "BatchSize": 50,
      "PollIntervalMilliseconds": 1000,
      "LeaseSeconds": 30,
      "MaximumAttempts": 10,
      "RetryBaseSeconds": 5,
      "RetryMaximumSeconds": 300
    },
    "Retention": {
      "Enabled": true,
      "CleanupIntervalHours": 24,
      "CompletedInboxRetentionDays": 30,
      "PublishedOutboxRetentionDays": 30,
      "BatchSize": 1000
    }
  }

}
